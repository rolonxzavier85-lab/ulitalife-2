using BepInEx;
using BepInEx.Configuration;
using HarmonyLib;

namespace HL2Kill
{
    [BepInPlugin("com.you.hl2kill", "HL2 Enemies for ULTRAKILL", "0.1.0")]
    public class Plugin : BaseUnityPlugin
    {
        public static ConfigEntry<bool> Enabled;

        void Awake()
        {
            Enabled = Config.Bind("General", "EnableHL2Enemies", true,
                "Swap ULTRAKILL enemies for Half-Life 2 stand-ins");
            new Harmony("com.you.hl2kill").PatchAll();
            Logger.LogInfo("HL2Kill loaded");
        }
    }

